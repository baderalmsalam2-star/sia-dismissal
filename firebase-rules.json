{
  "rules": {
    ".read": false,
    ".write": false,
    "schools": {
      "$school": {
        ".read": "$school.length >= 20",
        ".write": "$school.length >= 20 && newData.exists()",
        "clock": { ".validate": "newData.isNumber()" },
        "settings": {
          "minutes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600" },
          "pin": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "inbox": { ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 40" },
          "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "rad": { ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 20000" },
          "h1": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
          "h2": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
          "$other": { ".validate": false }
        },
        "buildings": {
          ".write": "newData.exists()",
          "$b": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "code": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "desc": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "addr": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "map": { ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().beginsWith('https://')" },
            "order": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "students": {
          ".write": "newData.exists()",
          "$s": {
            "n": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "c": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "b": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "p": { ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        },
        "calls": {
          "$s": {
            ".validate": "root.child('schools').child($school).child('students').child($s).exists()",
            "t": { ".validate": "newData.isNumber()" },
            "o": { ".validate": "newData.isNumber()" },
            "r": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "d": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "p": {
      "$tok": {
        ".write": "!data.exists() && newData.val() === true && $tok.length >= 20 && $tok.length <= 40",
        ".validate": "newData.val() === true"
      }
    },
    "inbox": {
      "$k": {
        ".read": "$k.length >= 20",
        "$tok": {
          ".write": "$k.length >= 20 && root.child('p').child($tok).exists()",
          "t": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "d": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "$other": { ".validate": false }
        }
      }
    },
    "pub": {
      "$k": {
        ".read": "$k.length >= 20",
        ".write": "$k.length >= 20 && newData.exists()",
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "r": { ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 20000" },
        "h1": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
        "h2": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
        "$other": { ".validate": false }
      }
    }
  }
}
